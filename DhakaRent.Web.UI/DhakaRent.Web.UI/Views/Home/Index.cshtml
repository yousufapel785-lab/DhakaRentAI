@{
    ViewData["Title"] = "Find Your Home";
}

<style>
    /* Scoped homepage styles: do not affect dashboards or the shared layout. */
    .drhome {
        --home-ink: #20272d;
        --home-muted: #5d6870;
        --home-line: #e3e5e1;
        --home-yellow: #f2c94c;
        --home-yellow-hover: #e7bb36;
        color: var(--home-ink);
        font-family: "Segoe UI", Tahoma, Arial, sans-serif;
        font-size: 16px;
        line-height: 1.65;
        text-rendering: auto;
        padding: 26px 0 52px;
    }

    .drhome a { text-decoration: none; }
    .drhome * { box-sizing: border-box; }

    .drhome-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.12fr) minmax(0, .88fr);
        align-items: center;
        gap: 36px;
        padding: clamp(26px, 4vw, 62px);
        background: linear-gradient(118deg, #ffffff 0%, #fffdf7 62%, #fff2cb 100%);
        border: 1px solid var(--home-line);
        border-radius: 28px;
        box-shadow: 0 18px 55px rgba(30, 39, 45, .055);
        overflow: hidden;
    }

    .drhome-kicker {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 7px 12px;
        border-radius: 100px;
        background: #fff2c8;
        color: #77560d;
        font-size: 12px;
        font-weight: 750;
        letter-spacing: .65px;
        text-transform: uppercase;
        margin-bottom: 22px;
    }

    .drhome-kicker-dot {
        width: 7px;
        height: 7px;
        background: #c49722;
        border-radius: 50%;
    }

    body.dr-app .drhome h1 {
        color: var(--home-ink);
        font-size: clamp(34px, 4.1vw, 58px);
        font-weight: 800;
        line-height: 1.11;
        letter-spacing: -1.9px;
        margin-bottom: 20px;
        max-width: 720px;
    }

    .drhome h1 .drhome-highlight { color: #a47711; }

    .drhome-intro {
        font-size: 17px;
        line-height: 1.78;
        color: var(--home-muted);
        max-width: 555px;
        margin: 0 0 26px;
    }

    .drhome-actions { display: flex; flex-wrap: wrap; gap: 12px; }

    .drhome-action {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 9px;
        padding: 13px 19px;
        min-height: 48px;
        border-radius: 12px;
        font-weight: 750;
        font-size: 14px;
        border: 1px solid transparent;
        cursor: pointer;
        transition: transform .18s ease, background-color .18s ease, box-shadow .18s ease;
    }

    .drhome-action:hover { transform: translateY(-2px); }
    .drhome-action:focus-visible { outline: 3px solid #b48a24; outline-offset: 3px; }

    .drhome-action-primary {
        background: var(--home-yellow);
        color: #252c31 !important;
        box-shadow: 0 8px 20px rgba(191, 148, 36, .16);
    }
    .drhome-action-primary:hover { background: var(--home-yellow-hover); color: #252c31 !important; }

    .drhome-action-secondary {
        background: #fff;
        border-color: #d2d7d4;
        color: #252c31 !important;
    }
    .drhome-action-secondary:hover { background: #f5f6f1; color: #252c31 !important; }

    .drhome-highlights {
        display: flex;
        flex-wrap: wrap;
        gap: 11px 21px;
        margin-top: 32px;
        padding-top: 22px;
        border-top: 1px solid #e9e4d7;
        color: #4d5a62;
        font-size: 13px;
        font-weight: 600;
    }

    .drhome-highlights span { display: inline-flex; align-items: center; gap: 7px; }
    .drhome-check { color: #168163; font-weight: 800; }

    /* Decorative, non-interactive house visual. No fabricated property listing. */
    .drhome-visual {
        min-height: 345px;
        position: relative;
        border-radius: 24px;
        background: radial-gradient(circle at 75% 20%, #ffdc73 0%, #ffedb8 37%, #f5f0e4 73%, #e7ebe9 100%);
        border: 1px solid #e7e2d5;
        overflow: hidden;
        display: grid;
        place-items: center;
        padding: 18px;
    }

    .drhome-visual::before,
    .drhome-visual::after {
        content: "";
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,.35);
        pointer-events: none;
    }
    .drhome-visual::before { width: 260px; height: 260px; right: -90px; top: -105px; }
    .drhome-visual::after { width: 150px; height: 150px; left: -50px; bottom: -70px; }

    .drhome-house-svg {
        position: relative;
        z-index: 1;
        display: block;
        max-width: 100%;
        width: min(390px, 100%);
        height: auto;
        filter: drop-shadow(0 18px 15px rgba(61,72,67,.13));
    }

    .drhome-visual-note {
        position: absolute;
        z-index: 2;
        bottom: 17px;
        left: 17px;
        right: 17px;
        background: rgba(255,255,255,.90);
        border: 1px solid rgba(227,229,225,.9);
        border-radius: 14px;
        padding: 12px 15px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: 0 5px 24px rgba(25,35,40,.08);
    }
    .drhome-visual-note-icon {
        display: grid;
        place-items: center;
        background: #fff2c8;
        border-radius: 11px;
        width: 39px;
        height: 39px;
        font-size: 20px;
        color: #886211;
        flex-shrink: 0;
    }
    .drhome-visual-note strong { display: block; color: #263039; font-size: 14px; line-height: 1.35; }
    .drhome-visual-note small { color: #617078; font-size: 12px; }

    .drhome-section { margin-top: 42px; }
    .drhome-section-heading { margin-bottom: 19px; }
    .drhome-overline {
        color: #9d7318;
        font-size: 12px;
        letter-spacing: 1px;
        text-transform: uppercase;
        font-weight: 800;
        margin: 0 0 5px;
    }
    body.dr-app .drhome h2 {
        font-size: clamp(24px, 3vw, 34px);
        line-height: 1.25;
        color: #20272d;
        font-weight: 800;
        letter-spacing: -.8px;
        margin: 0 0 9px;
    }
    .drhome-section-heading > p:last-child { color: #647079; margin-bottom: 0; }

    /* Closed by default; users open on demand. Native details works without JS. */
    .drhome-search-box {
        border: 1px solid var(--home-line);
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 7px 24px rgba(30,39,45,.04);
        overflow: hidden;
        scroll-margin-top: 100px;
    }
    .drhome-search-box summary {
        cursor: pointer;
        padding: 22px 25px;
        display: flex;
        align-items: center;
        gap: 15px;
        list-style: none;
        color: #232d33;
    }
    .drhome-search-box summary::-webkit-details-marker { display: none; }
    .drhome-search-box summary:focus-visible { outline: 3px solid #d9b13d; outline-offset: -4px; }
    .drhome-search-icon {
        display: grid;
        place-items: center;
        width: 46px;
        height: 46px;
        border-radius: 14px;
        flex-shrink: 0;
        background: #fff0ba;
        color: #8a620e;
    }
    .drhome-search-title { display: block; font-weight: 750; font-size: 17px; }
    .drhome-search-caption { display: block; color: #65717a; font-size: 13px; }
    .drhome-chevron { margin-left: auto; transition: transform .2s ease; flex-shrink: 0; }
    .drhome-search-box[open] .drhome-chevron { transform: rotate(180deg); }
    .drhome-search-content { border-top: 1px solid var(--home-line); padding: 24px; }
    .drhome-search-content label { font-weight: 650; color: #2c353c; font-size: 14px; margin-bottom: 7px; }
    body.dr-app .drhome .drhome-search-content .form-control {
        border: 1px solid #cbd1ce;
        background: #fff;
        color: #20272d;
        border-radius: 10px;
        min-height: 46px;
    }
    body.dr-app .drhome .drhome-search-content .form-control:focus {
        border-color: #bd942f;
        box-shadow: 0 0 0 3px rgba(242,201,76,.22);
    }
    .drhome-search-submit {
        border: 0;
        color: #20272d;
        background: #f2c94c;
        border-radius: 11px;
        min-height: 46px;
        width: 100%;
        font-weight: 750;
        padding: 10px 16px;
        cursor: pointer;
    }
    .drhome-search-submit:hover { background: #e7bb36; }
    .drhome-search-submit:focus-visible { outline: 3px solid #b48a24; outline-offset: 3px; }

    .drhome-feature-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
    .drhome-feature {
        background: #fff;
        border: 1px solid var(--home-line);
        border-radius: 19px;
        padding: 27px 24px;
        min-width: 0;
        box-shadow: 0 5px 20px rgba(30,39,45,.035);
        transition: transform .18s ease, box-shadow .18s ease;
    }
    .drhome-feature:hover { transform: translateY(-3px); box-shadow: 0 14px 28px rgba(30,39,45,.08); }
    .drhome-feature-icon {
        display: grid;
        place-items: center;
        width: 49px;
        height: 49px;
        background: #fff0bb;
        border-radius: 15px;
        color: #6d5210;
        font-size: 20px;
        font-weight: 800;
        margin-bottom: 19px;
    }
    body.dr-app .drhome h3 { color: #222a30; font-size: 19px; font-weight: 750; margin-bottom: 9px; }
    .drhome-feature p { color: #626f78; font-size: 14px; margin-bottom: 0; }

    @@media (max-width: 991.98px) {
        .drhome-hero { grid-template-columns: 1fr; gap: 24px; }
        .drhome-visual { min-height: 280px; }
    }
    @@media (max-width: 767.98px) {
        .drhome { padding: 17px 0 36px; }
        .drhome-hero { border-radius: 20px; padding: 25px 20px; }
        body.dr-app .drhome h1 { letter-spacing: -.9px; }
        .drhome-intro { font-size: 15px; }
        .drhome-visual { min-height: 260px; }
        .drhome-feature-grid { grid-template-columns: 1fr; gap: 13px; }
        .drhome-search-box summary { padding: 18px; }
        .drhome-search-content { padding: 18px; }
        .drhome-section { margin-top: 31px; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .drhome-action, .drhome-feature, .drhome-chevron { transition: none; }
        .drhome-action:hover, .drhome-feature:hover { transform: none; }
    }
</style>

<div class="drhome">
    <!-- Premium welcome hero -->
    <section class="drhome-hero" aria-labelledby="drhomeHeroTitle">
        <div>
            <span class="drhome-kicker">
                <span class="drhome-kicker-dot" aria-hidden="true"></span>
                DhakaRent AI · Dhaka
            </span>

            <h1 id="drhomeHeroTitle">
                Find a place you'll love
                <span class="drhome-highlight">calling home.</span>
            </h1>

            <p class="drhome-intro">
                Discover rental properties across Dhaka, save your favorites,
                and connect with property owners—all in one place.
            </p>

            <div class="drhome-actions">
                <a asp-controller="Properties"
                   asp-action="Index"
                   class="drhome-action drhome-action-primary">
                    Explore Properties
                    <span aria-hidden="true">→</span>
                </a>

                <button type="button"
                        id="drhomeOpenSearch"
                        class="drhome-action drhome-action-secondary">
                    Search Rentals
                </button>

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="Register"
                       class="drhome-action drhome-action-secondary">
                        Get Started
                    </a>
                }
            </div>

            <div class="drhome-highlights" aria-label="Platform highlights">
                <span><span class="drhome-check" aria-hidden="true">✓</span> Admin-reviewed listings</span>
                <span><span class="drhome-check" aria-hidden="true">✓</span> Dhaka-focused search</span>
                <span><span class="drhome-check" aria-hidden="true">✓</span> Save favorite homes</span>
            </div>
        </div>

        <div class="drhome-visual" aria-hidden="true">
            <!-- Original vector illustration; not an actual property listing. -->
            <svg class="drhome-house-svg" viewBox="0 0 420 340" xmlns="http://www.w3.org/2000/svg" role="img">
                <ellipse cx="213" cy="301" rx="170" ry="20" fill="#bac3ba" opacity=".5" />
                <rect x="112" y="143" width="200" height="151" rx="9" fill="#e5ded2" />
                <rect x="125" y="152" width="175" height="142" rx="5" fill="#f9f7ef" />
                <path d="M89 151L209 56 333 151" stroke="#303a40" stroke-width="22" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                <path d="M101 147L210 60 320 147" fill="#637571" />
                <rect x="184" y="211" width="55" height="83" rx="3" fill="#768e85" />
                <rect x="195" y="222" width="33" height="72" fill="#526861" />
                <circle cx="220" cy="256" r="3.7" fill="#f2c94c" />
                <rect x="139" y="169" width="49" height="42" rx="4" fill="#9fcbd0" stroke="#526861" stroke-width="6" />
                <path d="M163 169V211" stroke="#526861" stroke-width="5" />
                <rect x="239" y="169" width="49" height="42" rx="4" fill="#9fcbd0" stroke="#526861" stroke-width="6" />
                <path d="M263 169V211" stroke="#526861" stroke-width="5" />
                <rect x="138" y="228" width="32" height="30" rx="4" fill="#efd7a2" />
                <rect x="268" y="228" width="32" height="30" rx="4" fill="#efd7a2" />
                <rect x="61" y="259" width="57" height="38" rx="6" fill="#9eac8a" />
                <circle cx="80" cy="243" r="35" fill="#8ea886" />
                <circle cx="108" cy="240" r="27" fill="#b1bc96" />
                <rect x="342" y="215" width="11" height="84" rx="4" fill="#8e826b" />
                <circle cx="348" cy="198" r="45" fill="#a1ad87" />
                <circle cx="321" cy="207" r="31" fill="#c2c8a0" />
                <circle cx="376" cy="202" r="27" fill="#c2c8a0" />
                <path d="M92 296H334" stroke="#c9c1b1" stroke-width="7" stroke-linecap="round" />
            </svg>
            <div class="drhome-visual-note">
                <span class="drhome-visual-note-icon">⌂</span>
                <span>
                    <strong>A simpler way to find home</strong>
                    <small>Search · Save · Connect</small>
                </span>
            </div>
        </div>
    </section>

    <!-- Collapsible search. Form uses the existing PropertiesController.Index query names. -->
    <section class="drhome-section" aria-labelledby="drhomeSearchHeading">
        <div class="drhome-section-heading">
            <p class="drhome-overline">Find your next home</p>
            <h2 id="drhomeSearchHeading">Search rental properties</h2>
            <p>Choose a location and budget when you're ready to search.</p>
        </div>

        <details class="drhome-search-box" id="drhomeRentalSearch">
            <summary>
                <span class="drhome-search-icon" aria-hidden="true">
                    <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                        <circle cx="10.8" cy="10.8" r="6.5" />
                        <path d="m16 16 5 5" />
                    </svg>
                </span>
                <span>
                    <span class="drhome-search-title">Find your rental property</span>
                    <span class="drhome-search-caption">Click to show location and rent filters</span>
                </span>
                <svg class="drhome-chevron" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#606a70" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6" />
                </svg>
            </summary>

            <div class="drhome-search-content">
                <form asp-controller="Properties" asp-action="Index" method="get">
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-4">
                            <label for="drhomeArea" class="form-label">Location / Area</label>
                            <input type="text" id="drhomeArea" name="Area"
                                   class="form-control" placeholder="e.g. Mirpur, Uttara" />
                        </div>
                        <div class="col-lg-3">
                            <label for="drhomeMinRent" class="form-label">Minimum Rent (BDT)</label>
                            <input type="number" id="drhomeMinRent" name="MinRent"
                                   min="0" step="0.01" class="form-control" placeholder="e.g. 10000" />
                        </div>
                        <div class="col-lg-3">
                            <label for="drhomeMaxRent" class="form-label">Maximum Rent (BDT)</label>
                            <input type="number" id="drhomeMaxRent" name="MaxRent"
                                   min="0" step="0.01" class="form-control" placeholder="e.g. 25000" />
                        </div>
                        <div class="col-lg-2">
                            <button type="submit" class="drhome-search-submit">Search Homes</button>
                        </div>
                    </div>
                </form>
            </div>
        </details>
    </section>

    <!-- Feature cards -->
    <section class="drhome-section" aria-labelledby="drhomeWorksHeading">
        <div class="drhome-section-heading text-center">
            <p class="drhome-overline">Simple & smart renting</p>
            <h2 id="drhomeWorksHeading">How DhakaRent AI works</h2>
            <p>Find properties, connect with owners, and explore listings that have passed admin review.</p>
        </div>

        <div class="drhome-feature-grid">
            <article class="drhome-feature">
                <div class="drhome-feature-icon" aria-hidden="true">01</div>
                <h3>Discover homes</h3>
                <p>Explore rental listings with area, property type, budget and bedroom filters.</p>
            </article>
            <article class="drhome-feature">
                <div class="drhome-feature-icon" aria-hidden="true">02</div>
                <h3>Save & connect</h3>
                <p>Keep favorites in your wishlist, contact owners and request a viewing.</p>
            </article>
            <article class="drhome-feature">
                <div class="drhome-feature-icon" aria-hidden="true">03</div>
                <h3>List with confidence</h3>
                <p>Property owners can manage listings, which are reviewed before publication.</p>
            </article>
        </div>
    </section>
</div>

<script>
    // Open the native search panel from the hero CTA (no library required).
    document.getElementById('drhomeOpenSearch')?.addEventListener('click', function () {
        const panel = document.getElementById('drhomeRentalSearch');
        if (!panel) return;
        panel.open = true;
        panel.scrollIntoView({ block: 'start', behavior: 'smooth' });
        panel.querySelector('input[name="Area"]')?.focus({ preventScroll: true });
    });
</script>
