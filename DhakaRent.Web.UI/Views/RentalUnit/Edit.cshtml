@model DhakaRent.Web.UI.ViewModels.RentalUnitFormViewModel

@{
    ViewData["Title"] = "Edit Rental Unit";

    int unitId = (int)ViewBag.UnitId;
    int floorId = (int)ViewBag.FloorId;
    string floorLabel = (string)ViewBag.FloorLabel;
    string buildingName = (string)ViewBag.BuildingName;
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="fw-bold mb-2">Edit Rental Unit</h2>

        <p class="text-muted mb-1">
            Building: <strong>@buildingName</strong>
        </p>

        <p class="text-muted mb-0">
            Floor:
            <strong>
                @(string.IsNullOrWhiteSpace(floorLabel)
                    ? "Selected Floor"
                    : floorLabel)
            </strong>
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <form asp-controller="RentalUnit"
                          asp-action="Edit"
                          asp-route-id="@unitId"
                          method="post">

                        <!-- General Validation Errors -->
                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Unit Number -->
                        <div class="mb-3">

                            <label asp-for="UnitNumber"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="UnitNumber"
                                   class="form-control"
                                   maxlength="30"
                                   placeholder="e.g. 101" />

                            <span asp-validation-for="UnitNumber"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="row">

                            <!-- Size -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="SizeInSqFt"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="SizeInSqFt"
                                       type="number"
                                       min="1"
                                       max="100000"
                                       step="0.01"
                                       class="form-control" />

                                <span asp-validation-for="SizeInSqFt"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Monthly Rent -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="StandardMonthlyRent"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="StandardMonthlyRent"
                                       type="number"
                                       min="0"
                                       max="100000000"
                                       step="0.01"
                                       class="form-control" />

                                <span asp-validation-for="StandardMonthlyRent"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Bedrooms -->
                            <div class="col-md-6 mb-3">

                                <label asp-for="Bedrooms"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Bedrooms"
                                       type="number"
                                       min="0"
                                       max="50"
                                       step="1"
                                       class="form-control" />

                                <span asp-validation-for="Bedrooms"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Bathrooms -->
                            <div class="col-md-6 mb-4">

                                <label asp-for="Bathrooms"
                                       class="form-label fw-semibold">
                                </label>

                                <input asp-for="Bathrooms"
                                       type="number"
                                       min="0"
                                       max="50"
                                       step="1"
                                       class="form-control" />

                                <span asp-validation-for="Bathrooms"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                        <!-- Occupancy Information -->
                        <div class="alert alert-info">
                            Occupancy status is managed separately
                            and cannot be changed from this form.
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                            <a asp-controller="RentalUnit"
                               asp-action="Index"
                               asp-route-floorId="@floorId"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
