@model DhakaRent.Web.UI.ViewModels.PropertyCreateViewModel

@{
    ViewData["Title"] = "Add New Property";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-8">

            <h2 class="mb-2">Add New Property</h2>

            <p class="text-muted mb-4">
                Submit your property details for admin approval.
            </p>

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <form asp-action="CreateProperty"
                          asp-controller="PropertyOwner"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Title"
                                   class="form-label"></label>
                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="e.g. 2 Bedroom Apartment in Mirpur" />
                            <span asp-validation-for="Title"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PropertyType"
                                   class="form-label"></label>
                            <select asp-for="PropertyType"
                                    asp-items="Html.GetEnumSelectList<DhakaRent.Entities.Enums.PropertyType>()"
                                    class="form-select">
                            </select>
                            <span asp-validation-for="PropertyType"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label"></label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe your property..."></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Area"
                                   class="form-label"></label>
                            <input asp-for="Area"
                                   class="form-control"
                                   placeholder="e.g. Mirpur, Dhanmondi, Uttara" />
                            <span asp-validation-for="Area"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address"
                                   class="form-label"></label>
                            <textarea asp-for="Address"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Full property address"></textarea>
                            <span asp-validation-for="Address"
                                  class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SizeInSqFt"
                                       class="form-label"></label>
                                <input asp-for="SizeInSqFt"
                                       type="number"
                                       step="0.01"
                                       class="form-control" />
                                <span asp-validation-for="SizeInSqFt"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="MonthlyRent"
                                       class="form-label"></label>
                                <input asp-for="MonthlyRent"
                                       type="number"
                                       step="0.01"
                                       class="form-control" />
                                <span asp-validation-for="MonthlyRent"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Bedrooms"
                                       class="form-label"></label>
                                <input asp-for="Bedrooms"
                                       type="number"
                                       class="form-control" />
                                <span asp-validation-for="Bedrooms"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Bathrooms"
                                       class="form-label"></label>
                                <input asp-for="Bathrooms"
                                       type="number"
                                       class="form-control" />
                                <span asp-validation-for="Bathrooms"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AvailableFrom"
                                   class="form-label"></label>
                            <input asp-for="AvailableFrom"
                                   type="date"
                                   class="form-control" />
                            <span asp-validation-for="AvailableFrom"
                                  class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="IsFurnished"
                                   class="form-check-input" />
                            <label asp-for="IsFurnished"
                                   class="form-check-label"></label>
                        </div>

                        <div class="alert alert-info">
                            <strong>Approval process:</strong>
                            Your property will remain pending until
                            an administrator reviews and approves it.
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                Submit Property
                            </button>

                            <a asp-action="Dashboard"
                               asp-controller="PropertyOwner"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
