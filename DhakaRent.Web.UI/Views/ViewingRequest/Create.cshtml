@model DhakaRent.Web.UI.ViewModels.ViewingRequestFormViewModel

@{
    ViewData["Title"] = "Request Property Viewing";

    // Minimum viewing date and time in Bangladesh
    var minViewingDateTime = DateTime.UtcNow
        .AddHours(6)
        .AddMinutes(1)
        .ToString("yyyy-MM-ddTHH:mm");
}



<div class="container py-4">

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0">
                        Request Property Viewing
                    </h4>
                </div>

                <div class="card-body p-4">

                    <p class="text-muted">
                        Select your preferred date and time
                        to visit this property.
                    </p>

                    <div class="alert alert-info">
                        <strong>Property ID:</strong>
                        @Model.PropertyId
                    </div>

                    <form asp-controller="ViewingRequest"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="PropertyId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- Preferred viewing date and time -->
                        <div class="mb-3">

                            <label asp-for="RequestedDateTimeLocal"
                                   class="form-label fw-semibold">
                            </label>

                            
                            
                            <input asp-for="RequestedDateTimeLocal"
                                   type="datetime-local"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   min="@minViewingDateTime"
                                   class="form-control"
                                   required />

                            <span asp-validation-for="RequestedDateTimeLocal"
                                  class="text-danger">
                            </span>


                            <div class="form-text">
                                Please select a future date and time.
                                All times are in Bangladesh Time (UTC+6).
                            </div>

                        </div>

                        <!-- Optional tenant message -->
                        <div class="mb-3">

                            <label asp-for="TenantMessage"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="TenantMessage"
                                      class="form-control"
                                      rows="4"
                                      maxlength="1000"
                                      placeholder="Write a message to the property owner (optional)...">
                            </textarea>

                            <span asp-validation-for="TenantMessage"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Maximum 1000 characters.
                            </div>

                        </div>

                        <!-- Submit button -->
                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-primary btn-lg">
                                Submit Viewing Request
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
