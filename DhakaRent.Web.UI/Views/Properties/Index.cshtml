@model DhakaRent.Web.UI.ViewModels.PublicPropertySearchViewModel

@using DhakaRent.Entities.Enums

@{
    ViewData["Title"] = "Available Properties";
    var isTenant = User.IsInRole("Tenant");
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="container py-4">

    <div class="mb-4">
        <h1>Browse properties</h1>
        <p class="text-muted">
            <img src="~/icons/shield-check.svg" width="18" height="18" alt="" /> Listings are reviewed before they appear here.
        </p>
    </div>

    @foreach (var (key, style) in new[] { ("SuccessMessage", "success"), ("InfoMessage", "info"), ("ErrorMessage", "danger") })
    {
        if (TempData[key] is string message)
        {
            <div class="alert alert-@style" role="status">@message</div>
        }
    }

    <!-- Search and Filter Form -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h2 class="h5 mb-3">Filter listings</h2>

            <form asp-controller="Properties"
                  asp-action="Index"
                  method="get">

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <!-- Area -->
                    <div class="col-md-4">
                        <label asp-for="Area"
                               class="form-label">
                            Area
                        </label>

                        <input asp-for="Area"
                               class="form-control"
                               placeholder="e.g. Mirpur" />
                    </div>

                    <!-- Property Type -->
                    <div class="col-md-4">
                        <label asp-for="PropertyType"
                               class="form-label">
                            Property Type
                        </label>

                        <select asp-for="PropertyType"
                                asp-items="Html.GetEnumSelectList<PropertyType>()"
                                class="form-select">

                            <option value="">
                                All Property Types
                            </option>

                        </select>
                    </div>

                    <!-- Bedrooms -->
                    <div class="col-md-4">
                        <label asp-for="Bedrooms"
                               class="form-label">
                            Bedrooms
                        </label>

                        <input asp-for="Bedrooms"
                               type="number"
                               min="0"
                               step="1"
                               class="form-control"
                               placeholder="Any" />
                    </div>

                    <!-- Minimum Rent -->
                    <div class="col-md-6">
                        <label asp-for="MinRent"
                               class="form-label">
                            Minimum Rent (BDT)
                        </label>

                        <input asp-for="MinRent"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control"
                               placeholder="Minimum rent" />
                    </div>

                    <!-- Maximum Rent -->
                    <div class="col-md-6">
                        <label asp-for="MaxRent"
                               class="form-label">
                            Maximum Rent (BDT)
                        </label>

                        <input asp-for="MaxRent"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control"
                               placeholder="Maximum rent" />
                    </div>

                </div>

                <div class="mt-4 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Search Properties
                    </button>

                    <a asp-controller="Properties"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear Filters
                    </a>

                </div>

            </form>

        </div>
    </div>

    <div class="result-heading">
        <h2 class="h4">Available rentals</h2>
        <span class="text-muted">@Model.Properties.Count @(Model.Properties.Count == 1 ? "listing" : "listings")</span>
        @if (isTenant)
        {
            <a asp-controller="SavedProperty" asp-action="Index" class="ms-auto">My wishlist</a>
        }
    </div>
    @if (!Model.Properties.Any())
    {
        <div class="alert alert-info">No rentals match these filters. Try a different area or a wider budget.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model.Properties)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="card listing-card h-100">
                        <div class="card-body">
                            <span class="listing-type">@item.PropertyType</span>
                            <h3 class="card-title h4">@item.Title</h3>
                            <p class="text-muted mb-0">@item.Address · @item.Area, Dhaka</p>
                            <p class="listing-specs">@item.Bedrooms bed · @item.Bathrooms bath · @item.SizeInSqFt.ToString("N0") sqft<br />
                                @(item.IsFurnished ? "Furnished" : "Unfurnished")
                            </p>
                            <p class="listing-rent">৳@item.MonthlyRent.ToString("N0") <small>/ month</small></p>
                            <a asp-controller="Properties" asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-outline-primary" aria-label="View details for @item.Title">View details</a>
                            @if (isTenant)
                            {
                                <form asp-controller="SavedProperty" asp-action="@(item.IsSavedToWishlist ? "Remove" : "Save")" method="post"
                                      onsubmit="@(item.IsSavedToWishlist ? "return confirm('Remove this property from your wishlist?')" : null)">
                                    <input type="hidden" name="propertyId" value="@item.Id" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button class="btn btn-outline-secondary w-100">@(item.IsSavedToWishlist ? "Remove from wishlist" : "Save to wishlist")</button>
                                </form>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
