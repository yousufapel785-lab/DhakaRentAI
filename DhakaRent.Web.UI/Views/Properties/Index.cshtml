@model DhakaRent.Web.UI.ViewModels.PublicPropertySearchViewModel
@using DhakaRent.Entities.Enums

@{
    ViewData["Title"] = "Browse Properties";

    bool isTenant =
        User.Identity?.IsAuthenticated == true &&
        User.IsInRole("Tenant");

    // Preserve current filters for the next redirect step.
    string returnUrl =
        $"{Context.Request.Path}{Context.Request.QueryString}";
}

<style>
    /* ============================
           MAIN DARK BACKGROUND
        ============================ */

    <div class="mb-4">
        <h1>Browse properties</h1>
        <p class="text-muted">
            <img src="~/icons/shield-check.svg" width="18" height="18" alt="" /> Listings are reviewed before they appear here.
        </p>
    </div>

    /* ============================
           HERO SECTION
        ============================ */

    .browse-hero {
        position: relative;
        overflow: hidden;
        padding: 32px;
        border-radius: 22px;
        border: 1px solid rgba(94, 234, 212, 0.22);
        background: linear-gradient( 110deg, #153b51, #10253e 70% );
        box-shadow: 0 14px 35px rgba(0, 0, 0, 0.18);
    }

            <h2 class="h5 mb-3">Filter listings</h2>

    .browse-hero h1 {
        color: #ffffff;
        font-weight: 800;
        font-size: clamp(27px, 4vw, 39px);
        line-height: 1.25;
    }

    .browse-hero p {
        color: #bdcede;
        font-size: 15px;
        margin-bottom: 0;
    }

    /* ============================
           FILTER PANEL
        ============================ */

    .browse-filter-card {
        background: #14263d;
        border: 1px solid #29445e;
        border-radius: 20px;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.13);
    }

        .browse-filter-card h5 {
            color: #f8fafc;
            font-weight: 700;
        }

        .browse-filter-card .form-label {
            color: #cbd5e1;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .browse-filter-card .form-control,
        .browse-filter-card .form-select {
            background-color: #0d1c30;
            color: #f8fafc;
            border: 1px solid #39516c;
            border-radius: 10px;
            min-height: 45px;
        }

            .browse-filter-card .form-control::placeholder {
                color: #8295ad;
                opacity: 1;
            }

            .browse-filter-card .form-control:focus,
            .browse-filter-card .form-select:focus {
                background-color: #102138;
                color: #ffffff;
                border-color: #2dd4bf;
                box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.15);
            }

            .browse-filter-card .form-select option {
                background: #102138;
                color: #ffffff;
            }

    .browse-search-btn {
        background: #2dd4bf;
        border: 1px solid #2dd4bf;
        color: #062c32;
        border-radius: 10px;
        font-weight: 700;
        padding: 11px 22px;
    }

        .browse-search-btn:hover {
            background: #5eead4;
            border-color: #5eead4;
            color: #062c32;
        }

    .browse-clear-btn {
        border: 1px solid #64748b;
        border-radius: 10px;
        color: #e2e8f0;
        padding: 11px 22px;
        font-weight: 600;
    }

        .browse-clear-btn:hover {
            background: #253c55;
            border-color: #94a3b8;
            color: #ffffff;
        }

    /* ============================
           RESULTS HEADER
        ============================ */

    .browse-results-title {
        color: #ffffff;
        font-weight: 800;
        font-size: 24px;
    }

    .browse-results-count {
        color: #a9bdd0;
        font-size: 14px;
    }

    .browse-wishlist-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 17px;
        border: 1px solid #fb7185;
        border-radius: 11px;
        background: rgba(244, 63, 94, 0.09);
        color: #fda4af;
        text-decoration: none;
        font-weight: 700;
    }

        .browse-wishlist-link:hover {
            background: rgba(244, 63, 94, 0.20);
            color: #ffffff;
        }

    /* ============================
           PROPERTY CARDS
        ============================ */

    .browse-rental-card {
        position: relative;
        overflow: hidden;
        height: 100%;
        border: 1px solid #2c4963;
        border-radius: 20px;
        background: linear-gradient( 180deg, #1b334d 0%, #13263e 100% );
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    }

        .browse-rental-card::before {
            content: "";
            position: absolute;
            inset: 0 0 auto 0;
            height: 4px;
            background: linear-gradient( 90deg, #14b8a6, #38bdf8, #fb7185 );
        }

        .browse-rental-card:hover {
            transform: translateY(-5px);
            border-color: #2dd4bf;
            box-shadow: 0 18px 42px rgba(0, 0, 0, 0.26);
        }

    .browse-property-name {
        color: #f8fafc;
        font-size: 19px;
        font-weight: 750;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .browse-property-area {
        color: #a8c0d5;
        font-size: 13px;
    }

    /* ============================
           HEART REACTION
        ============================ */

    .browse-heart-form {
        flex-shrink: 0;
        margin: 0;
    }

    .browse-heart-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        border-radius: 50%;
        border: 2px solid #fb7185;
        background: rgba(251, 113, 133, 0.10);
        cursor: pointer;
        padding: 0;
        transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }

        .browse-heart-button svg {
            display: block;
            width: 29px;
            height: 29px;
            flex-shrink: 0;
        }

        .browse-heart-button:hover {
            transform: scale(1.10);
            background: rgba(251, 113, 133, 0.24);
            box-shadow: 0 0 18px rgba(251, 113, 133, 0.20);
        }

        .browse-heart-button:focus-visible {
            outline: 3px solid #5eead4;
            outline-offset: 3px;
        }

        /* SAVED: Filled red heart and bright background */
        .browse-heart-button.is-saved {
            border-color: #ff466a;
            background: rgba(255, 70, 106, 0.20);
            box-shadow: 0 0 0 5px rgba(255, 70, 106, 0.07);
        }

            .browse-heart-button.is-saved:hover {
                background: rgba(255, 70, 106, 0.30);
            }

    .browse-saved-label {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 30px;
        background: rgba(16, 185, 129, 0.14);
        border: 1px solid rgba(52, 211, 153, 0.25);
        color: #6ee7b7;
        font-size: 12px;
        font-weight: 700;
    }

    .browse-not-saved-label {
        display: inline-flex;
        align-items: center;
        padding: 6px 12px;
        border-radius: 30px;
        background: rgba(148, 163, 184, 0.12);
        border: 1px solid rgba(148, 163, 184, 0.17);
        color: #cbd5e1;
        font-size: 12px;
        font-weight: 600;
    }

    /* ============================
           PROPERTY INFORMATION
        ============================ */

    .browse-address {
        color: #b5c8d9;
        line-height: 1.6;
        font-size: 13px;
        overflow-wrap: anywhere;
    }

    .browse-facts {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin-top: 12px;
    }

    .browse-fact {
        background: rgba(7, 19, 35, 0.34);
        border: 1px solid rgba(148, 163, 184, 0.13);
        border-radius: 11px;
        padding: 11px;
        min-width: 0;
    }

    .browse-fact-label {
        display: block;
        font-size: 11px;
        color: #95adc5;
        margin-bottom: 5px;
    }

    .browse-fact-value {
        display: block;
        font-size: 13px;
        font-weight: 700;
        color: #f1f5f9;
        overflow-wrap: anywhere;
    }

    /* ============================
           PRICE AND DETAILS BUTTON
        ============================ */

    .browse-price-section {
        margin-top: auto;
        padding-top: 18px;
    }

    .browse-price {
        font-size: 26px;
        font-weight: 800;
        color: #5eead4;
    }

        .browse-price small {
            font-size: 13px;
            font-weight: 500;
            color: #a8c0d5;
        }

    .browse-view-button {
        display: block;
        width: 100%;
        margin-top: 13px;
        padding: 12px 16px;
        border-radius: 11px;
        background: linear-gradient(100deg, #2dd4bf, #22c1d6);
        color: #062c32;
        font-size: 14px;
        font-weight: 800;
        text-align: center;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .browse-view-button:hover {
            color: #062c32;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(45, 212, 191, 0.25);
        }

        .browse-view-button:focus-visible {
            outline: 3px solid #f8fafc;
            outline-offset: 3px;
        }

    /* ============================
           EMPTY STATE
        ============================ */

    .browse-empty-state {
        background: #172c44;
        border: 1px solid #33516c;
        border-radius: 16px;
        padding: 30px;
        color: #d4e5f2;
    }

    /* ============================
           RESPONSIVE
        ============================ */

    @@media (max-width: 767px) {
        .browse-hero {
            padding: 23px;
        }

        .browse-results-title {
            font-size: 21px;
        }

        .browse-filter-actions {
            flex-direction: column;
        }

            .browse-filter-actions .btn {
                width: 100%;
            }
    }

    @@media (max-width: 380px) {
        .browse-facts {
            grid-template-columns: 1fr;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .browse-rental-card,
        .browse-heart-button,
        .browse-view-button {
            transition: none;
        }

            .browse-rental-card:hover,
            .browse-heart-button:hover,
            .browse-view-button:hover {
                transform: none;
            }
    }
</style>

<div class="rent-browse">

    <div class="container">

        <!-- ========================
             HERO HEADER
        ========================= -->
        <div class="browse-hero mb-4">

            <span class="browse-eyebrow">
                DHAKARENT AI · FIND YOUR HOME
            </span>

            <h1 class="mb-3">
                Explore Your Next Home
            </h1>

            <p>
                Discover verified rental listings across Dhaka.
                Search, compare and save your favorite properties.
            </p>

        </div>

        <!-- ========================
             NOTIFICATIONS
        ========================= -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" role="alert">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info" role="alert">
                @TempData["InfoMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @TempData["ErrorMessage"]
            </div>
        }

        <!-- ========================
             SEARCH FILTERS
        ========================= -->
        <div class="browse-filter-card mb-5">

            <div class="p-4">

                <h5 class="mb-4">
                    Search &amp; Filter Properties
                </h5>

                <form asp-controller="Properties"
                      asp-action="Index"
                      method="get">

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <div class="row g-3">

                        <!-- Area -->
                        <div class="col-md-4">

                            <label asp-for="Area"
                                   class="form-label">
                                Area
                            </label>

                            <input asp-for="Area"
                                   class="form-control"
                                   placeholder="e.g. Mirpur, Uttara" />

                        </div>

                        <!-- Property Type -->
                        <div class="col-md-4">

                            <label asp-for="PropertyType"
                                   class="form-label">
                                Property Type
                            </label>

                            <select asp-for="PropertyType"
                                    asp-items="Html.GetEnumSelectList<PropertyType>()"
                                    class="form-select">

                                <option value="">
                                    All Property Types
                                </option>

                            </select>

                        </div>

                        <!-- Bedrooms -->
                        <div class="col-md-4">

                            <label asp-for="Bedrooms"
                                   class="form-label">
                                Bedrooms
                            </label>

                            <input asp-for="Bedrooms"
                                   type="number"
                                   min="0"
                                   step="1"
                                   class="form-control"
                                   placeholder="Any" />

                        </div>

                        <!-- Minimum Rent -->
                        <div class="col-md-6">

                            <label asp-for="MinRent"
                                   class="form-label">
                                Minimum Rent (BDT)
                            </label>

                            <input asp-for="MinRent"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="Minimum rent" />

                        </div>

                        <!-- Maximum Rent -->
                        <div class="col-md-6">

                            <label asp-for="MaxRent"
                                   class="form-label">
                                Maximum Rent (BDT)
                            </label>

                            <input asp-for="MaxRent"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="Maximum rent" />

                        </div>

                    </div>

                    <div class="d-flex gap-2 flex-wrap
                        browse-filter-actions mt-4">

                        <button type="submit"
                                class="btn browse-search-btn">
                            Search Properties
                        </button>

                        <a asp-controller="Properties"
                           asp-action="Index"
                           class="btn browse-clear-btn">
                            Clear Filters
                        </a>

                    </div>

                </form>

            </div>

        </div>

        <!-- ========================
             RESULTS HEADER
        ========================= -->
        <div class="d-flex justify-content-between
            align-items-center flex-wrap gap-3 mb-4">

            <div>

                <h3 class="browse-results-title mb-1">
                    Available Properties
                </h3>

                <div class="browse-results-count">
                    @Model.Properties.Count properties found
                </div>

            </div>

            @if (isTenant)
            {
                <a asp-controller="SavedProperty"
                   asp-action="Index"
                   class="browse-wishlist-link">

    <div class="result-heading">
        <h2 class="h4">Available rentals</h2>
        <span class="text-muted">@Model.Properties.Count @(Model.Properties.Count == 1 ? "listing" : "listings")</span>
    </div>
    @if (!Model.Properties.Any())
    {
        <div class="alert alert-info">No rentals match these filters. Try a different area or a wider budget.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in Model.Properties)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="card listing-card h-100">
                        <div class="card-body">
                            <span class="listing-type">@item.PropertyType</span>
                            <h3 class="card-title h4">@item.Title</h3>
                            <p class="text-muted mb-0">@item.Address · @item.Area, Dhaka</p>
                            <p class="listing-specs">@item.Bedrooms bed · @item.Bathrooms bath · @item.SizeInSqFt.ToString("N0") sqft<br />
                                @(item.IsFurnished ? "Furnished" : "Unfurnished")
                            </p>
                            <p class="listing-rent">৳@item.MonthlyRent.ToString("N0") <small>/ month</small></p>
                            <a asp-controller="Properties" asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-outline-primary" aria-label="View details for @item.Title">View details</a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
