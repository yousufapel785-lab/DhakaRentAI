@model DhakaRent.Web.UI.ViewModels.PublicPropertySearchViewModel

@using DhakaRent.Entities.Enums

@{
    ViewData["Title"] = "Available Properties";
}

<div class="container py-4">

    <div class="mb-4">
        <h2>Find Your Rental Property</h2>
        <p class="text-muted">
            Search approved rental properties in Dhaka.
        </p>
    </div>

    <!-- Search and Filter Form -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="mb-3">Search & Filter</h5>

            <form asp-controller="Properties"
                  asp-action="Index"
                  method="get">

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <!-- Area -->
                    <div class="col-md-4">
                        <label asp-for="Area"
                               class="form-label">
                            Area
                        </label>

                        <input asp-for="Area"
                               class="form-control"
                               placeholder="e.g. Mirpur" />
                    </div>

                    <!-- Property Type -->
                    <div class="col-md-4">
                        <label asp-for="PropertyType"
                               class="form-label">
                            Property Type
                        </label>

                        <select asp-for="PropertyType"
                                asp-items="Html.GetEnumSelectList<PropertyType>()"
                                class="form-select">

                            <option value="">
                                All Property Types
                            </option>

                        </select>
                    </div>

                    <!-- Bedrooms -->
                    <div class="col-md-4">
                        <label asp-for="Bedrooms"
                               class="form-label">
                            Bedrooms
                        </label>

                        <input asp-for="Bedrooms"
                               type="number"
                               min="0"
                               step="1"
                               class="form-control"
                               placeholder="Any" />
                    </div>

                    <!-- Minimum Rent -->
                    <div class="col-md-6">
                        <label asp-for="MinRent"
                               class="form-label">
                            Minimum Rent (BDT)
                        </label>

                        <input asp-for="MinRent"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control"
                               placeholder="Minimum rent" />
                    </div>

                    <!-- Maximum Rent -->
                    <div class="col-md-6">
                        <label asp-for="MaxRent"
                               class="form-label">
                            Maximum Rent (BDT)
                        </label>

                        <input asp-for="MaxRent"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control"
                               placeholder="Maximum rent" />
                    </div>

                </div>

                <div class="mt-4 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Search Properties
                    </button>

                    <a asp-controller="Properties"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Clear Filters
                    </a>

                </div>

            </form>

        </div>
    </div>

    <!-- Search Results -->
    <div class="mb-3">
        <h4>Available Properties</h4>

        <p class="text-muted">
            <strong>@Model.Properties.Count</strong>
            properties found
        </p>
    </div>

    @if (!Model.Properties.Any())
    {
        <div class="alert alert-info">
            No properties found matching your search.
            Try changing or clearing the filters.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model.Properties)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm">

                        <div class="card-body">

                            <h5 class="card-title">
                                @item.Title
                            </h5>

                            <p class="text-muted mb-2">
                                @item.Area, Dhaka
                            </p>

                            <p class="mb-2">
                                <strong>Address:</strong>
                                @item.Address
                            </p>

                            <p class="mb-2">
                                <strong>Type:</strong>
                                @item.PropertyType
                            </p>

                            <p class="mb-2">
                                <strong>Size:</strong>
                                @item.SizeInSqFt.ToString("N0") sqft
                            </p>

                            <p class="mb-2">
                                <strong>Bedrooms:</strong>
                                @item.Bedrooms
                            </p>

                            <p class="mb-2">
                                <strong>Bathrooms:</strong>
                                @item.Bathrooms
                            </p>

                            <p class="mb-3">
                                <strong>Furnishing:</strong>
                                @(item.IsFurnished
                                    ? "Furnished"
                                    : "Unfurnished")
                            </p>

                            <h5 class="text-success">
                                ৳@item.MonthlyRent.ToString("N0")

                                <small class="text-muted">
                                    / month
                                </small>
                            </h5>

                            <a asp-controller="Properties"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-primary w-100 mt-3">
                                View Details
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
