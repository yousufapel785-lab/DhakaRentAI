@model DhakaRent.Web.UI.ViewModels.AdminPropertyReviewViewModel

@{
    ViewData["Title"] = "Review Property";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Review Property</h2>
            <p class="text-muted">
                Inspect the submitted property before making a decision.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="PendingProperties"
           class="btn btn-outline-secondary">
            Back to Pending List
        </a>
    </div>

    <!-- Property Information -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Property Information</h5>
        </div>

        <div class="card-body">

            <h4>@Model.Title</h4>

            <p class="text-muted">
                Property ID: #@Model.Id
            </p>

            <hr />

            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>Property Type:</strong>
                    <p>@Model.PropertyType</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Area:</strong>
                    <p>@Model.Area</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Full Address:</strong>
                    <p>@Model.Address</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Monthly Rent:</strong>
                    <p>৳ @Model.MonthlyRent.ToString("N2")</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Property Size:</strong>
                    <p>@Model.SizeInSqFt sq. ft.</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Bedrooms:</strong>
                    <p>@Model.Bedrooms</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Bathrooms:</strong>
                    <p>@Model.Bathrooms</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Furnished:</strong>
                    <p>@(Model.IsFurnished ? "Yes" : "No")</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Available From:</strong>
                    <p>
                        @(Model.AvailableFrom?.ToString("dd MMM yyyy")
                            ?? "Not specified")
                    </p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Submitted Date:</strong>
                    <p>@Model.CreatedAt.ToString("dd MMM yyyy")</p>
                </div>

            </div>

            <hr />

            <strong>Property Description:</strong>

            <p class="mt-2">
                @Model.Description
            </p>

        </div>
    </div>

    <!-- Property Owner Information -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Property Owner Information</h5>
        </div>

        <div class="card-body">

            <p>
                <strong>Owner Name:</strong>
                @Model.OwnerName
            </p>

            <p>
                <strong>Email:</strong>
                @Model.OwnerEmail
            </p>

        </div>
    </div>

    <!-- Listing Status -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <h5 class="mb-0">Listing Review Status</h5>
        </div>

        <div class="card-body">

            <span class="badge bg-warning text-dark">
                @Model.ListingStatus
            </span>

            <p class="text-muted mt-2 mb-0">
                This property is waiting for your approval.
            </p>

        </div>
    </div>

    <!-- Admin Approval Actions -->
    @if (Model.ListingStatus == "Pending")
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <h5 class="mb-0">Admin Decision</h5>
            </div>

            <div class="card-body">

                <p>
                    Review the property information carefully before
                    making your decision.
                </p>

                <div class="d-flex gap-2">

                    <form asp-controller="Admin"
                          asp-action="ApproveProperty"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-success"
                                onclick="return confirm('Are you sure you want to approve this property?');">
                            Approve Property
                        </button>

                    </form>

                    <a asp-controller="Admin"
                       asp-action="RejectProperty"
                       asp-route-id="@Model.Id"
                       class="btn btn-danger">
                        Reject Property
                    </a>

                </div>

            </div>
        </div>
    }


</div>
