@model IEnumerable<DhakaRent.Web.UI.ViewModels.AdminPendingPropertyViewModel>

@{
    ViewData["Title"] = "Pending Property Approvals";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Pending Property Approvals</h2>
            <p class="text-muted">
                Review property listings submitted by property owners.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    <!-- Pending Properties Count -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h6 class="text-muted">Total Pending Properties</h6>
            <h2>@Model.Count()</h2>
        </div>
    </div>

    <!-- Pending Properties Table -->
    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">Property Submissions</h5>
        </div>

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover">

                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Property Title</th>
                                <th>Property Type</th>
                                <th>Owner Name</th>
                                <th>Area</th>
                                <th>Monthly Rent</th>
                                <th>Submitted Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var property in Model)
                            {
                                <tr>
                                    <td>@property.Id</td>

                                    <td>
                                        <strong>@property.Title</strong>
                                    </td>

                                    <td>@property.PropertyType</td>

                                    <td>@property.OwnerName</td>

                                    <td>@property.Area</td>

                                    <td>
                                        ৳ @property.MonthlyRent.ToString("N2")
                                    </td>

                                    <td>
                                        @property.CreatedAt.ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        <a asp-controller="Admin"
                                           asp-action="ReviewProperty"
                                           asp-route-id="@property.Id"
                                           class="btn btn-primary btn-sm">
                                            Review
                                        </a>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <h5>No Pending Properties</h5>

                    <p class="text-muted">
                        There are currently no property submissions
                        waiting for approval.
                    </p>
                </div>
            }

        </div>
    </div>

</div>
