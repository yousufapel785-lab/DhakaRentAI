@model DhakaRent.Web.UI.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">

    <!-- Dashboard Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Admin Dashboard</h2>
            <p class="text-muted mb-0">
                Manage property listings and approvals.
            </p>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">

        <!-- Total Properties -->
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Properties</h6>
                    <h2 class="fw-bold mb-0">
                        @Model.TotalProperties
                    </h2>
                </div>
            </div>
        </div>

        <!-- Pending Properties -->
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Pending Properties</h6>
                    <h2 class="fw-bold text-warning mb-0">
                        @Model.PendingProperties
                    </h2>
                </div>
            </div>
        </div>

        <!-- Approved Properties -->
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Approved Properties</h6>
                    <h2 class="fw-bold text-success mb-0">
                        @Model.ApprovedProperties
                    </h2>
                </div>
            </div>
        </div>

        <!-- Rejected Properties -->
        <div class="col-md-6 col-xl-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Rejected Properties</h6>
                    <h2 class="fw-bold text-danger mb-0">
                        @Model.RejectedProperties
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Recent Pending Properties -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white d-flex
            justify-content-between align-items-center py-3">

            <h5 class="fw-bold mb-0">
                Recent Pending Properties
            </h5>

            <a asp-controller="Admin"
               asp-action="PendingProperties"
               class="btn btn-sm btn-outline-primary">
                View All Pending
            </a>

        </div>

        <div class="card-body">

            @if (Model.RecentPendingProperties.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No pending properties found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Property</th>
                                <th>Area</th>
                                <th>Monthly Rent</th>
                                <th>Submitted Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var property in Model.RecentPendingProperties)
                            {
                                <tr>
                                    <td>@property.Title</td>

                                    <td>@property.Area</td>

                                    <td>
                                        ৳@property.MonthlyRent.ToString("N0")
                                    </td>

                                    <td>
                                        @property.CreatedAt.ToString("dd MMM yyyy")
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>
