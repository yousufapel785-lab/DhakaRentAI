@model DhakaRent.Web.UI.ViewModels.RejectPropertyViewModel

@{
    ViewData["Title"] = "Reject Property";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header">
            <h4 class="mb-0">Reject Property Listing</h4>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <strong>Attention!</strong>
                Please provide a clear reason for rejecting this property.
                The Property Owner will be able to see this reason.
            </div>

            <form asp-controller="Admin"
                  asp-action="RejectProperty"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="PropertyId" />

                <div class="mb-3">

                    <label asp-for="Reason"
                           class="form-label"></label>

                    <textarea asp-for="Reason"
                              class="form-control"
                              rows="5"
                              placeholder="Explain why this property is being rejected...">
                    </textarea>

                    <span asp-validation-for="Reason"
                          class="text-danger">
                    </span>

                </div>

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <button type="submit"
                        class="btn btn-danger">
                    Confirm Rejection
                </button>

                <a asp-controller="Admin"
                   asp-action="PendingProperties"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
