@model IReadOnlyList<DhakaRent.Entities.Models.Floor>

@{
    ViewData["Title"] = "Building Floors";

    int buildingId = (int)ViewBag.BuildingId;
    string buildingName = (string)ViewBag.BuildingName;
    bool isArchived = (bool)ViewBag.IsArchived;
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between
        align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Floors - @buildingName
            </h1>

            <p class="text-muted mb-0">
                Manage floors in this building.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Building"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Buildings
            </a>

            @if (!isArchived)
            {
                <a asp-controller="Floor"
                   asp-action="Create"
                   asp-route-buildingId="@buildingId"
                   class="btn btn-primary">
                    + Add Floor
                </a>
            }

        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Archived Building Notice -->
    @if (isArchived)
    {
        <div class="alert alert-warning">
            This building is archived.
            Floors can be viewed but not modified.
        </div>
    }

    <!-- Floor List -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                Floor List (@Model.Count)
            </h5>
        </div>

        <div class="card-body">

            @if (Model.Count == 0)
            {
                <div class="text-center py-5">

                    <h5>No Floors Found</h5>

                    <p class="text-muted">
                        This building does not have
                        any floors yet.
                    </p>

                    @if (!isArchived)
                    {
                        <a asp-controller="Floor"
                           asp-action="Create"
                           asp-route-buildingId="@buildingId"
                           class="btn btn-primary">
                            Add First Floor
                        </a>
                    }

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Floor Number</th>
                                <th>Floor Label</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var floor in Model)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @floor.FloorNumber
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(floor.Label)
                                            ? "Not specified"
                                            : floor.Label)
                                    </td>

                                    
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">

                                            <!-- Manage Rental Units -->
                                            <a asp-controller="RentalUnit"
                                               asp-action="Index"
                                               asp-route-floorId="@floor.Id"
                                               class="btn btn-sm btn-outline-success">
                                                Manage Units
                                            </a>

                                            @if (!isArchived)
                                            {
                                                <!-- Edit Floor -->
                                                <a asp-controller="Floor"
                                                   asp-action="Edit"
                                                   asp-route-id="@floor.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                    Edit
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">
                                                    View only
                                                </span>
                                            }

                                        </div>
                                    </td>


                                </tr>
                            }

                        </tbody>
                    </table>

                </div>
            }

        </div>
    </div>

</div>
